        damping: 0.1,
        transmission: 0.05,
    ),

    fluid: Some((
        viscosity: 0.02,
        surface_tension: 0.3,
        incompressibility: 0.95,
    )),

    render: (
        color: (0.05, 0.35, 0.9, 0.7),
        texture: Some("sprites/Sprite-0001.png"),
